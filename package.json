{
  "name": "ai-adaptive-learning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:standalone": "next build && node scripts/pack-standalone.mjs",
    "prepack": "npm run build:standalone",
    "dist:win": "npm run build:standalone && electron-builder --win nsis"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^1.3.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openrouter/ai-sdk-provider": "^0.7.3",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "adm-zip": "^0.6.1",
    "ai": "^4.3.19",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.9",
    "next": "15.4.2",
    "pdfjs-dist": "^5.3.93",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.3.8",
    "react-katex": "^3.1.0",
    "react-resizable-panels": "^3.0.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.3.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5"
  },
  "type": "module",
  "bin": {
    "ai-adaptive-learning": "bin/cli.js"
  },
  "files": [
    "bin",
    "standalone",
    "README.md",
    "docs/media"
  ],
  "main": "electron/main.js",
  "build": {
    "appId": "app.studynotes.desktop",
    "productName": "StudyNotes",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "icon": "build-assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "artifactName": "${productName}-Setup-${version}.${ext}"
  }
}
