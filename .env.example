# Folder of notes to study (created with a sample note if missing).
# Top-level subfolders map to courses; app state lives in <STUDY_DIR>/.study.
STUDY_DIR=./notes

# LLM via OpenRouter (concepts, quiz, flashcards, knowledge graph, chat).
OPENROUTER_API_KEY=

# Model routing: "fast" handles bulk generation (concepts, flashcards,
# knowledge graph, chat titles, answer explanations), "smart" handles the
# live tutor and chat replies.
# OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
# OPENROUTER_MODEL_SMART=deepseek/deepseek-v4.1-flash  # default; anthropic/claude-sonnet-5 for premium tutoring

# Offline alternative: point at a running Ollama server instead of OpenRouter.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
