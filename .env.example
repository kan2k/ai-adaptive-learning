# Folder of notes to study (created with a sample note if missing).
# Top-level subfolders map to courses; app state lives in <STUDY_DIR>/.study.
STUDY_DIR=./notes

# LLM via OpenRouter (concepts, quiz, flashcards, knowledge graph, chat).
OPENROUTER_API_KEY=

# Offline alternative: point at a running Ollama server instead of OpenRouter.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
